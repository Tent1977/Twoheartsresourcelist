rules_version = '2';

// Shelter Watch — "post now, flag later".
// Merge this block into the project's existing rules; do not replace them.
//
// Collections
//   shelterwatch_comments/{id}                 public reviews (no author id stored)
//   shelterwatch_comments/{id}/reports/{uid}   one report per person, never readable
//   shelterwatch_authors/{facilityId}__{uid}   private: one review per person per place
//   shelterwatch_ratelimit/{uid}               private: one post per minute per person
//
// Every review is written in one batch: the comment + the author record + the
// rate-limit record. Every report is one batch: the report doc + reportCount+1.
// functions/index.js re-screens each new review on the server and holds it if
// the browser's screen was skipped.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function okRating(r, k) { return !(k in r) || (r[k] is int && r[k] >= 1 && r[k] <= 5); }
    function validRatings(r) {
      return r is map
        && r.keys().hasOnly(['happy', 'comfortable', 'affordable', 'residentsFirst', 'clean', 'safe',
                             'rulesFair', 'privacy', 'staff', 'management', 'recommend'])
        && okRating(r, 'happy') && okRating(r, 'comfortable') && okRating(r, 'affordable')
        && okRating(r, 'residentsFirst') && okRating(r, 'clean') && okRating(r, 'safe')
        && okRating(r, 'rulesFair') && okRating(r, 'privacy') && okRating(r, 'staff')
        && okRating(r, 'management') && okRating(r, 'recommend');
    }

    function okFact(f, k, opts) { return !(k in f) || f[k] in opts; }
    function validFacts(f) {
      let yn = ['yes', 'no'];
      return f is map
        && f.keys().hasOnly(['petsAllowed', 'visitorsAllowed', 'rulesLevel', 'kitchen', 'bathroom',
                             'furnished', 'staffOnSite', 'peerSupport', 'traumaInformed',
                             'harmReduction', 'events', 'acceptsRegistrants'])
        && okFact(f, 'petsAllowed', ['yes', 'no', 'service_animals_only'])
        && okFact(f, 'visitorsAllowed', ['yes', 'no', 'restricted'])
        && okFact(f, 'rulesLevel', ['few', 'moderate', 'many'])
        && okFact(f, 'kitchen', ['individual', 'communal', 'both', 'none'])
        && okFact(f, 'bathroom', ['private', 'communal', 'both'])
        && okFact(f, 'furnished', ['yes', 'no', 'partial'])
        && okFact(f, 'staffOnSite', ['24_7', 'business_hours', 'some', 'none'])
        && okFact(f, 'peerSupport', yn) && okFact(f, 'traumaInformed', yn)
        && okFact(f, 'harmReduction', yn) && okFact(f, 'events', yn)
        && okFact(f, 'acceptsRegistrants', ['yes', 'no', 'case_by_case']);
    }

    // BEGIN GENERATED (scripts/build-shelter-watch.js) — do not edit by hand
    function knownFacility(id) { return id in ['moana-apt-homes', 'orvis-ring-park-apartments', 'pinewood-terrace-apartments', 'reno-housing-authority-housing-choice-voucher-section-8-prog', '521-lake-st-workforce-housing', 'i-street-apartments-2026-i-st', 'jacobs-rha-65-unit-building-465-w-2nd-st', 'maple-leaves', 'marvel-way-apartments', 'railyard-flats', 'reno-housing-authority-public-housing-8-complexes-750-units', 'riverside-artist-lofts', 'sarrazin-arms-apartments', 'sierra-cove', 'the-afton-at-sparks-marina', '440-reno-avenue', 'alpine-haven-apartments', 'aspen-terrace-apartments', 'austin-crest-apartments', 'banbridge-apartments', 'boulder-creek-apartments', 'city-center-apartments', 'juniper-village', 'pinyon-apartments', 'rail-house-306-10th-st', 'silver-terrace-apartments', 'sky-mountain-by-vintage', 'skyline-flats', 'south-peak-by-vintage-formerly-diamond-creek-apartments', 'southridge-apartments-i', 'southwest-village-apartments', 'steamboat-by-vintage', 'summit-ridge-apartments-summit-heights-senior-apartments-pha', 'terracina-reno', 'the-bluffs-apartments', 'the-prospector', 'the-ridge-at-sun-valley', 'vista-point-apartments', 'wedekind-apartments', 'zephyr-pointe-apartments', 'ala-moana-apartments', 'arbor-cove-at-virginia-lake', 'carriage-stone-senior-apartments', 'sierra-crest-senior-apartments', 'silver-sage-senior-residence', 'silver-sage-at-neil-road', 'silvercrest-senior-residence', 'sutro-senior-sanctuary', 'vintage-hills-senior-apartments', 'vintage-at-citi-vista-citivista-senior-apartments', 'vintage-at-spanish-springs', 'vintage-at-the-crossings', 'vintage-at-washington-station', 'community-housing-land-trust-community-foundation-of-norther', 'north-reno-712-unit-affordable-subdivision', 'truckee-meadows-habitat-for-humanity', 'city-of-reno-regional-rental-deposit-assistance-nevada-affor', 'rebuilding-together-northern-nevada-safe-and-healthy-housing', 'washoe-county-senior-services-housing-referrals', 'colony-inn-colony-studios-apartments', 'hopwa-northern-nevada-hopes-housing-assistance', 'carville-park-apartments', 'centennial-park-annex', 'golden-i-apartments-golden-apartments', 'pilgrims-rest-project-based', 'washoe-mill-apartments', 'carville-court', 'catholic-charities-of-northern-nevada-psh-intake', 'dick-scott-manor', 'hi-way-40-highway-40-supportive-housing', 'hope-landing', 'line-drive-apartments', 'nevada-cares-campus-permanent-supportive-housing', 'our-place-washoe-county-psh-component', 'essex-manor', 'john-mcgraw-court', 'mineral-manor', 'myra-birch-manor', 'rha-public-housing-project-based-assistance-waitlists', 'rha-reno-avenue-development', 'silver-sage-court', 'silverada-manor', 'stead-manor', 'the-village-at-hawk-view-hawk-view-apartments-redevelopment', 'tom-sawyer-village', 'willie-j-wynn-apartments', 'yorkshire-terrace', 'washoe-county-rapid-rehousing-housing-navigation-via-coordin', 'metropolitan-gardens-apartments', 'reno-silvercrest-residence', 'sierra-manor-i-ii', 'john-butterworth-estates', 'nevada-section-811-project-rental-assistance-pra', 'william-j-raggio-plaza', 'emergency-housing-vouchers-ehv-rha', 'foster-youth-to-independence-fyi-foster-youth-vouchers-rha', 'hud-vash-veterans-affairs-supportive-housing-rha', 'housing-choice-voucher-section-8-reno-housing-authority', 'rha-project-based-vouchers-special-populations', 'domestic-violence-resource-center-dvrc-emergency-shelter', 'inter-tribal-council-of-nevada-family-violence-prevention-sh', 'safe-embrace', 'nevada-cares-campus-emergency-shelter', 'reno-sparks-gospel-mission-women-s-emergency-shelter', 'salvation-army-reno', 'washoe-county-crossroads-men-s-women-s-women-children-s', 'family-promise-of-reno-sparks-northern-nevada', 'our-place-women-s-shelter-family-shelter', 'reno-housing-authority-hpp-motel-assistance', 'nevada-cares-campus-safe-camp', 'our-place-safe-parking-pilot', 'american-red-cross-hawk-fire-evacuation-shelter', 'good-neighbors-warming-center', 'nevada-cares-campus-resource-center-warming-cooling-center', 'reno-sparks-gospel-mission-men-s-cold-weather-emergency-shel', 'washoe-county-winter-overflow-nevada-cares-campus-our-place', 'children-s-cabinet-safe-place-runaway-homeless-youth-crisis', 'eddy-house-24-hour-youth-shelter-drop-in', 'kids-kottage', 'hope-springs', 'the-village-on-sage-street', 'battle-born-housing-plus-st-vincent-s-residences', 'bristlecone-family-resources-gate-transitional-living', 'crossroads-men-s-supportive-community-main-campus', 'crossroads-women-s-program-river-house-serenity-homes', 'life-changes-inc-sober-homes', 'pathway-program', 'recovery-road-women-s-sober-living', 'reno-sparks-gospel-mission-men-s-long-term-recovery-program', 'reno-sparks-gospel-mission-women-s-long-term-recovery-progra', 'step2-lighthouse-campus-transitional-housing', 'salvation-army-reno-rehabilitation-program', 'the-empowerment-center-the-launching-pad', 'the-life-change-center-renewal-women-renew-men-transitional', 'well-care-men-s-crossroads-housing-contract-likely-welcare-h', 'welvida-soberhomes-reno', 'northern-nevada-transitional-housing-nnth', 'ridge-house-men-s-residential-homes', 'ridge-house-women-s-home', 'step-1-inc', 'awaken-housing-program', 'caaw-transitional-housing-program', 'casa-de-vida-maternity-home-house-of-hope', 'crossroads-women-with-children-and-families', 'faith-based-men-s-transitional-home-1912-wilder-st', 'hosanna-home', 'safe-embrace-transitional-housing', 'second-chances-transitional-housing-for-women', 'vincent-s-transitional-center-st-vincent-s', 'crossroads-park-house-veteran-beds', 'ridge-house-veterans-home', 'voa-veteran-transitional-housing-at-nevada-cares-campus', 'vitality-veterans-program-vitality-veteran-housing', 'westcare-reno-homefront-veterans-transitional-living', 'eddy-house-transitional-living-community-tlc-36-community-li']; }
    function confidentialFacility(id) { return id in ['domestic-violence-resource-center-dvrc-emergency-shelter', 'inter-tribal-council-of-nevada-family-violence-prevention-sh', 'safe-embrace', 'ridge-house-men-s-residential-homes', 'ridge-house-women-s-home', 'awaken-housing-program', 'caaw-transitional-housing-program', 'safe-embrace-transitional-housing', 'ridge-house-veterans-home']; }
    // END GENERATED

    function authorPath(facilityId) {
      return /databases/$(database)/documents/shelterwatch_authors/$(facilityId + '__' + request.auth.uid);
    }

    match /shelterwatch_comments/{commentId} {
      // Public: live reviews with fewer than 3 reports, or ones a moderator approved.
      // Held, hidden and removed reviews are only visible in the Firebase console.
      allow read: if (resource.data.status == 'visible' && resource.data.reportCount < 3)
                  || resource.data.status == 'approved';

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'facilityId', 'text', 'relationship', 'ratings', 'facts',
             'status', 'heldReasons', 'reportCount', 'createdAt'])
        && request.resource.data.facilityId is string
        && request.resource.data.facilityId.size() > 0
        && request.resource.data.facilityId.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 3000
        && request.resource.data.relationship in [
             'current_resident', 'former_resident', 'staff',
             'family_or_friend', 'service_provider', 'other']
        && validRatings(request.resource.data.ratings)
        && validFacts(request.resource.data.facts)
        && knownFacility(request.resource.data.facilityId)
        && request.resource.data.status in ['visible', 'held']
        // A review of a confidential (DV) site must start out held, so it is never public before a moderator sees it.
        && (request.resource.data.status == 'held' || !confidentialFacility(request.resource.data.facilityId))
        && request.resource.data.heldReasons is list
        && request.resource.data.heldReasons.size() <= 6
        && (request.resource.data.heldReasons.size() == 0 || request.resource.data.heldReasons[0] is string && request.resource.data.heldReasons[0].size() <= 200)
        && (request.resource.data.heldReasons.size() <= 1 || request.resource.data.heldReasons[1] is string && request.resource.data.heldReasons[1].size() <= 200)
        && (request.resource.data.heldReasons.size() <= 2 || request.resource.data.heldReasons[2] is string && request.resource.data.heldReasons[2].size() <= 200)
        && (request.resource.data.heldReasons.size() <= 3 || request.resource.data.heldReasons[3] is string && request.resource.data.heldReasons[3].size() <= 200)
        && (request.resource.data.heldReasons.size() <= 4 || request.resource.data.heldReasons[4] is string && request.resource.data.heldReasons[4].size() <= 200)
        && (request.resource.data.heldReasons.size() <= 5 || request.resource.data.heldReasons[5] is string && request.resource.data.heldReasons[5].size() <= 200)
        && request.resource.data.reportCount == 0
        && request.resource.data.createdAt == request.time
        // one review per person per place, written in the same batch
        && getAfter(authorPath(request.resource.data.facilityId)).data.commentId == commentId
        // one post per minute per person, written in the same batch
        && getAfter(/databases/$(database)/documents/shelterwatch_ratelimit/$(request.auth.uid)).data.last == request.time;

      // Reporting: only reportCount may change, by exactly +1, and only when
      // this person's report doc is created in the same batch.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && !exists(/databases/$(database)/documents/shelterwatch_comments/$(commentId)/reports/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/shelterwatch_comments/$(commentId)/reports/$(request.auth.uid));

      // Moderators approve/hide/remove with the Firebase console or Admin SDK.
      allow delete: if false;

      match /reports/{reporterId} {
        allow read: if false; // who reported whom is never public
        allow create: if signedIn()
          && reporterId == request.auth.uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/shelterwatch_comments/$(commentId)).data.reportCount
             == get(/databases/$(database)/documents/shelterwatch_comments/$(commentId)).data.reportCount + 1;
        allow update, delete: if false;
      }
    }

    match /shelterwatch_authors/{key} {
      // key = facilityId + '__' + uid. Only the author can see their own record.
      allow read: if signedIn() && key.matches('.*__' + request.auth.uid);
      allow create: if signedIn()
        && key.matches('.*__' + request.auth.uid)
        && request.resource.data.keys().hasOnly(['commentId'])
        && request.resource.data.commentId is string;
      allow update, delete: if false; // one review per person per place, for good
    }

    match /shelterwatch_ratelimit/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && (resource == null || request.time > resource.data.last + duration.value(60, 's'));
      allow delete: if false;
    }
  }
}
