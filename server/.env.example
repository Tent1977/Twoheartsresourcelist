# Copy to .env and source it before `npm run serve`. Never commit the real file.
#
#   set -a; source server/.env; set +a; npm run serve

# --- Copilot (pick one or both; the UI can switch between them live) ---
# Claude — best judgement on rhetoric, tone and what to say next.
ANTHROPIC_API_KEY=

# DeepSeek — cheap enough to re-score every sentence rather than a sample.
DEEPSEEK_API_KEY=

# --- Speech to text with live diarization ---
# Without this the app falls back to the browser speech API, which transcribes
# but cannot tell speakers apart.
DEEPGRAM_API_KEY=
# Needed to mint short-lived browser keys so the key above never leaves this
# process. Find it in the Deepgram console under Project Settings.
DEEPGRAM_PROJECT_ID=

# --- Server ---
PORT=8787
# Leave as localhost. Binding wider exposes the broker to the whole network.
HOST=127.0.0.1
